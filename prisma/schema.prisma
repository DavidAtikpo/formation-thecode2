generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["formation"]
}

model User {
  id                         String       @id @default(cuid())
  email                      String       @unique
  passwordHash               String
  role                       UserRole     @default(user)
  emailVerified              Boolean      @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime     @default(now())
  blockedAt                  DateTime?
  stripeCustomerId           String?      @unique
  enrollments                Enrollment[]
  talentProfile              TalentProfile?

  @@schema("formation")
}

model Enrollment {
  id                         String           @id @default(cuid())
  userId                     String
  firstName                  String
  lastName                   String
  country                    String
  phone                      String
  address                    String
  passportPhotoUrl           String?
  passportPublicId           String?
  identityDocumentType       IdentityDocumentType?
  identityDocumentUrl        String?
  identityDocumentPublicId   String?
  identityVerificationStatus IdentityVerificationStatus @default(pending)
  identityVerifiedAt         DateTime?
  identityExpiryDate         DateTime?
  identityExtractedName      String?
  identityVerificationError  String?
  domain                     FormationDomain
  formationSession           FormationSession @default(july_2026)
  duration                   FormationDuration
  daysPerWeek                Int              @default(3)
  scheduleDays               String[]
  scheduleHours              String
  acceptedPrivacy            Boolean          @default(false)
  registrationFeeUsd         Int              @default(0)
  formationFeeUsd            Float            @default(0)
  installment1FeeUsd         Float            @default(0)
  installment2FeeUsd         Float            @default(0)
  installment3FeeUsd         Float            @default(0)
  amountXof                  Int
  amountUsd                  Int
  status                     EnrollmentStatus @default(pending_payment)
  paymentMethod              PaymentMethod?
  stripeSessionId            String?          @unique
  fedapayTransactionId       String?          @unique
  cryptoInvoiceId            String?          @unique
  formationPaymentMethod     PaymentMethod?
  formationStripeSessionId   String?          @unique
  formationFedapayTransactionId String?       @unique
  formationCryptoInvoiceId   String?          @unique
  installment3PaymentMethod  PaymentMethod?
  installment3StripeSessionId String?       @unique
  installment3FedapayTransactionId String?   @unique
  installment3CryptoInvoiceId String?       @unique
  registrationPaidAt         DateTime?
  installment1PaidAt         DateTime?
  installment2PaidAt         DateTime?
  installment3PaidAt         DateTime?
  formationPaidAt            DateTime?
  paidAt                     DateTime?
  certificateIssuedAt        DateTime?
  certificateUrl             String?
  certificateNumber          String?          @unique
  certificateSignedBy        String?
  skillLevel                 SkillLevel?
  yearsExperience            Int?
  masteredTechnologies       String[]
  skillProfileCompletedAt    DateTime?
  projectSiteUrl             String?
  projectSiteTitle           String?
  projectSiteSubmittedAt     DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  user                       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grades                     EnrollmentGrade[]
  receipts                   PaymentReceipt[]
  resourceDeliveries         ResourceDelivery[]

  @@index([userId])
  @@index([status])
  @@schema("formation")
}

model PaymentReceipt {
  id             String        @id @default(cuid())
  enrollmentId   String
  phase          PaymentPhase
  receiptNumber  String        @unique
  amountUsd      Int
  amountXof      Int
  paymentMethod  PaymentMethod
  reference      String?
  paidAt         DateTime
  emailSentAt    DateTime?
  createdAt      DateTime      @default(now())
  enrollment     Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, phase])
  @@index([enrollmentId])
  @@schema("formation")
}

model LearningResource {
  id               String               @id @default(cuid())
  title            String
  description      String?
  type             LearningResourceType
  fileUrl          String?
  filePublicId     String?
  externalUrl      String?
  domain           FormationDomain?
  formationSession FormationSession?
  duration         FormationDuration?
  published        Boolean              @default(false)
  publishedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deliveries       ResourceDelivery[]

  @@index([published])
  @@index([type])
  @@schema("formation")
}

model ResourceDelivery {
  id           String           @id @default(cuid())
  resourceId   String
  enrollmentId String
  deliveredAt  DateTime         @default(now())
  emailSentAt  DateTime?
  resource     LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([resourceId, enrollmentId])
  @@index([enrollmentId])
  @@schema("formation")
}

model EnrollmentGrade {
  id           String     @id @default(cuid())
  enrollmentId String
  title        String
  score        Float
  maxScore     Float      @default(20)
  comment      String?
  gradedAt     DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@schema("formation")
}

enum FormationDomain {
  frontend
  backend
  mobile
  fullstack
  seo_social

  @@schema("formation")
}

enum FormationDuration {
  two_weeks
  three_months
  four_months

  @@schema("formation")
}

enum FormationSession {
  july_2026
  august_2026
  late_august_2026

  @@schema("formation")
}

enum EnrollmentStatus {
  pending_payment
  active
  paid
  cancelled

  @@schema("formation")
}

enum PaymentMethod {
  stripe
  fedapay
  crypto

  @@schema("formation")
}

enum IdentityDocumentType {
  id_card
  passport

  @@schema("formation")
}

enum IdentityVerificationStatus {
  pending
  verified
  failed
  expired

  @@schema("formation")
}

enum PaymentPhase {
  registration
  formation
  installment_1
  installment_2
  installment_3

  @@schema("formation")
}

enum UserRole {
  user
  admin

  @@schema("formation")
}

enum LearningResourceType {
  course_pdf
  tutorial

  @@schema("formation")
}

enum SkillLevel {
  beginner
  experienced

  @@schema("formation")
}

enum TalentCategory {
  developer
  designer
  content
  seo
  other

  @@schema("formation")
}

enum JobContractType {
  cdi
  freelance
  stage
  mission

  @@schema("formation")
}

enum PublicationStatus {
  pending
  published
  archived

  @@schema("formation")
}

model TalentProfile {
  id              String              @id @default(cuid())
  userId          String?             @unique
  firstName       String
  lastName        String
  category        TalentCategory
  headline        String?
  bio             String?
  country         String?
  yearsExperience Int?
  skills          String[]
  portfolioUrl    String?
  availability    String[]
  status          PublicationStatus   @default(pending)
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@schema("formation")
}

model JobListing {
  id           String            @id @default(cuid())
  title        String
  company      String
  description  String
  category     TalentCategory
  location     String?
  remote       Boolean           @default(false)
  contractType JobContractType
  status       PublicationStatus @default(pending)
  publishedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([category])
  @@schema("formation")
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  country   String?
  city      String?
  region    String?
  ipHash    String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([country])
  @@index([createdAt])
  @@schema("formation")
}
