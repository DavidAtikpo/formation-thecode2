generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["formation"]
}

model User {
  id                         String       @id @default(cuid())
  email                      String       @unique
  passwordHash               String
  emailVerified              Boolean      @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime     @default(now())
  stripeCustomerId           String?      @unique
  enrollments                Enrollment[]

  @@schema("formation")
}

model Enrollment {
  id                String           @id @default(cuid())
  userId            String
  firstName         String
  lastName          String
  country           String
  phone             String
  address           String
  passportPhotoUrl  String
  passportPublicId  String
  domain            FormationDomain
  duration          FormationDuration
  daysPerWeek       Int              @default(3)
  scheduleDays      String[]
  scheduleHours     String
  acceptedPrivacy   Boolean          @default(false)
  amountXof            Int
  amountUsd            Int
  status               EnrollmentStatus @default(pending_payment)
  paymentMethod        PaymentMethod?
  stripeSessionId      String?          @unique
  fedapayTransactionId String?          @unique
  cryptoInvoiceId      String?          @unique
  paidAt               DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@schema("formation")
}

enum FormationDomain {
  frontend
  backend
  mobile
  fullstack
  seo_social

  @@schema("formation")
}

enum FormationDuration {
  two_weeks
  three_months
  four_months

  @@schema("formation")
}

enum EnrollmentStatus {
  pending_payment
  paid
  cancelled

  @@schema("formation")
}

enum PaymentMethod {
  stripe
  fedapay
  crypto

  @@schema("formation")
}
